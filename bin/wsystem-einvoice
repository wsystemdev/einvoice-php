#!/usr/bin/env php
<?php

declare(strict_types=1);

foreach ([__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $a) {
    if (is_file($a)) {
        require $a;
        break;
    }
}
if (!class_exists(\WSystem\EInvoice\Cli::class)) {
    fwrite(STDERR, "wsystem-einvoice: autoloader not found; run composer install\n");
    exit(2);
}
exit(\WSystem\EInvoice\Cli::run($argv, STDIN, STDOUT, STDERR));
